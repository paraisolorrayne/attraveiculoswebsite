# Ambiente LOCAL (docs/AMBIENTE_LOCAL.md). Copie para .env.local e preencha.
# Nada aqui aponta para produção: o banco é o local montado por
# scripts/local/montar-banco-local.sh, só com o esquema + dados sintéticos.

# Banco local (troque <seu-usuario> pelo seu usuário do Mac).
DATABASE_URL=postgres://<seu-usuario>@localhost:5432/attra_local

# Assinatura das sessões de login do admin. Gere com: openssl rand -base64 32
AUTH_SECRET=
